# ZeroGuard AI local development configuration
# Copy this file to .env and change values for your local machine.

# PostgreSQL
POSTGRES_DB=zeroguard
POSTGRES_USER=zeroguard_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Spring Boot backend
BACKEND_PORT=8080
JWT_SECRET=replace_with_a_long_random_development_secret
JWT_EXPIRATION_MINUTES=120
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALERT_RISK_THRESHOLD=80

# FastAPI ML service
ML_SERVICE_PORT=8000
MODEL_DIR=../models
MODEL_VERSION=0.1.0-dev
DEMO_MODE=true

# React frontend
VITE_API_BASE_URL=http://localhost:8080/api

